                "title_case": false,
                "type": "code",
                "value": "from lfx.custom import Component\nfrom lfx.io import MessageTextInput, Output, StrInput, IntInput\nfrom lfx.schema.message import Message\nimport json\nimport requests\n\n\nclass QuantAgentAPI(Component):\n    display_name = \"QuantAgent API\"\n    description = \"Appelle l'API FastAPI QuantAgent et retourne la réponse JSON.\"\n    documentation = \"http://localhost:8000/docs\"\n    icon = \"bot\"\n    name = \"QuantAgentAPI\"\n\n    inputs = [\n        MessageTextInput(\n            name=\"question\",\n            display_name=\"Question\",\n            info=\"Question métier envoyée à l'agent hybride.\",\n            required=True,\n        ),\n        StrInput(\n            name=\"api_url\",\n            display_name=\"API URL\",\n            value=\"http://127.0.0.1:8000/ask\",\n            info=\"Endpoint FastAPI /ask.\",\n        ),\n        IntInput(\n            name=\"timeout\",\n            display_name=\"Timeout (s)\",\n            value=30,\n        ),\n    ]\n\n    outputs = [\n        Output(display_name=\"Réponse\", name=\"answer\", method=\"build\"),\n    ]\n\n    def build(self, question: Message, api_url: str, timeout: int) -> Message:\n        text = question.text if hasattr(question, \"text\") else str(question)\n        response = requests.post(\n            api_url,\n            json={\"question\": text, \"mode\": \"hybrid\"},\n            timeout=timeout,\n        )\n        response.raise_for_status()\n        payload = response.json()\n        answer = payload.get(\"answer\", json.dumps(payload, ensure_ascii=False, indent=2))\n        hitl = payload.get(\"hitl\", {}).get(\"status\")\n        if hitl == \"PENDING_APPROVAL\":\n            answer += \"\\n\\n[HITL] Dossier en attente d'approbation humaine.\"\n        self.status = answer\n        return Message(text=answer)\n"
              },
