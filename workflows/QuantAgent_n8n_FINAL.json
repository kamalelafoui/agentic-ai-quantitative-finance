        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "8f1d0c1a-1a1a-4f1a-9a1a-000000000003",
      "name": "QuantAgent API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-300, 0]
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\nconst required = ['request_id','timestamp','agent','question','intent','answer','confidence','latency_ms','entities','sources','graph','quant','hitl','security','trace','disclaimer'];\nconst missing = required.filter((key) => !(key in data));\nif (missing.length) {\n  throw new Error('Contrat JSON invalide. Champs manquants: ' + missing.join(', '));\n}\nif (!['hybrid','vector','graph'].includes(data.agent.mode)) {\n  throw new Error('Mode agent invalide.');\n}\nreturn [{ json: data }];"
      },
