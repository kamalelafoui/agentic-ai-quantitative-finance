        "jsCode": "const body = $json.body ?? $json;\nif (!body.question || String(body.question).trim().length < 3) {\n  throw new Error('Le champ question est obligatoire (>= 3 caracteres).');\n}\nreturn [{ json: {\n  question: String(body.question),\n  portfolio_id: body.portfolio_id || 'PF-CORE-EU',\n  scenario_id: body.scenario_id || null,\n  mode: body.mode || 'hybrid',\n  top_k: Number(body.top_k || 4)\n}}];"
      },
      "id": "8f1d0c1a-1a1a-4f1a-9a1a-000000000002",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
